{
  "permissions": {
    "allow": [
      "Bash(gh issue view *)",
      "Bash(gh pr view *)"
    ],
    "deny": [
      "Read(~/.gnupg/**)",
      "Bash(brew uninstall *)",
      "Bash(brew remove *)",
      "Bash(brew autoremove *)",
      "Bash(brew cleanup *)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gsd-check-update.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gsd-context-monitor.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gsd-prompt-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/hooks/gsd-statusline.js\""
  },
  "enabledPlugins": {
    "planning-with-files@planning-with-files": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.gitconfig",
        "~/.git-credentials",
        "~/.npmrc"
      ],
      "denyRead": [
        "~/.gnupg/private-keys-v1.d",
        "~/.gnupg/secring.gpg"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "default",
  "theme": "dark-daltonized",
  "editorMode": "vim"
  "tui": "fullscreen"
}
