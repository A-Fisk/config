#!/usr/bin/env python3
import random
import re
import shutil
import textwrap
from pathlib import Path

FEEDBACK_FILE = Path.home() / "google_drive/03_General/usyd_workshop_feedback/select_feedback.md"

def main():
    if not FEEDBACK_FILE.exists():
        return

    text = FEEDBACK_FILE.read_text(encoding="utf-8")
    matches = re.findall(r'>\s*\"(.*?)\"\s*>\s*—\s*(.*?)(?=\n\n|\n[#>]|$)', text, re.DOTALL)
    if not matches:
        return

    quote, attribution = random.choice(matches)
    quote = " ".join(quote.split())
    attribution = " ".join(attribution.split()).replace("*", "")

    # Terminal-aware width: leave margin for borders and padding
    term_cols = shutil.get_terminal_size((80, 20)).columns
    content_width = max(26, min(term_cols - 8, 72))

    quote_lines = textwrap.wrap(f'"{quote}"', width=content_width)
    attr_line = f"— {attribution}"
    attr_lines = textwrap.wrap(attr_line, width=content_width)

    box_width = max(len(line) for line in quote_lines + attr_lines) + 2

    dim = "\033[2m"
    italic = "\033[3m"
    reset = "\033[0m"

    print(f"\n{dim}╭{'─' * box_width}╮")
    for line in quote_lines:
        print(f"│ {line.ljust(box_width - 1)}│")
    print(f"│{' ' * box_width}│")
    for line in attr_lines:
        padded = line.rjust(box_width - 2)
        print(f"{dim}│{reset} {italic}{padded}{reset} {dim}│")
    print(f"╰{'─' * box_width}╯{reset}\n")

if __name__ == "__main__":
    main()
